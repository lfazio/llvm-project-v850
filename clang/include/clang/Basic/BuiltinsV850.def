//===----------------------------------------------------------------------===//
//
// This file defines the V850-specific builtin function database. Users of
// this file must define the BUILTIN macro to make use of this information.
//
//===----------------------------------------------------------------------===//

// The format of this database matches clang/Basic/Builtins.def.

#if defined(BUILTIN) && !defined(TARGET_BUILTIN)
#define TARGET_BUILTIN(ID, TYPE, ATTRS, FEATURE) BUILTIN(ID, TYPE, ATTRS)
#endif

//===----------------------------------------------------------------------===//
// Base V850 Instructions (available on all variants)
//===----------------------------------------------------------------------===//

// DI - Disable interrupts (PSW.ID = 1)
// void __builtin_v850_di(void)
BUILTIN(__builtin_v850_di, "v", "n")

// EI - Enable interrupts (PSW.ID = 0)
// void __builtin_v850_ei(void)
BUILTIN(__builtin_v850_ei, "v", "n")

// LDSR - Load to system register
// void __builtin_v850_ldsr(unsigned int value, unsigned int regID)
BUILTIN(__builtin_v850_ldsr, "vUiIUi", "n")

// STSR - Store from system register
// unsigned int __builtin_v850_stsr(unsigned int regID)
BUILTIN(__builtin_v850_stsr, "UiIUi", "n")

// SATADD - Saturating add (2-operand form, base V850)
// int __builtin_v850_satadd(int a, int b)
// Returns: saturate(a + b)
BUILTIN(__builtin_v850_satadd, "iii", "nc")

// SATSUB - Saturating subtract (2-operand form, base V850)
// int __builtin_v850_satsub(int a, int b)
// Returns: saturate(b - a) (note operand order matches instruction encoding)
BUILTIN(__builtin_v850_satsub, "iii", "nc")

// SATSUBR - Saturating subtract reverse (2-operand form, base V850)
// int __builtin_v850_satsubr(int a, int b)
// Returns: saturate(a - b) (reverse operand order from SATSUB)
BUILTIN(__builtin_v850_satsubr, "iii", "nc")

//===----------------------------------------------------------------------===//
// Base V850 Special Instructions
//===----------------------------------------------------------------------===//

// HALT - Halt CPU until interrupt
// void __builtin_v850_halt(void)
BUILTIN(__builtin_v850_halt, "v", "n")

// TRAP - Software trap
// void __builtin_v850_trap(unsigned int vector)
// vector must be 0-31
BUILTIN(__builtin_v850_trap, "vIUi", "n")

//===----------------------------------------------------------------------===//
// Base V850 System Register Access
//
// Named builtins for common system registers (regID 0-5).
// These provide compile-time type safety and documentation.
//===----------------------------------------------------------------------===//

// EIPC - Exception/Interrupt saved PC (regID 0)
// unsigned int __builtin_v850_read_eipc(void)
BUILTIN(__builtin_v850_read_eipc, "Ui", "n")
// void __builtin_v850_write_eipc(unsigned int value)
BUILTIN(__builtin_v850_write_eipc, "vUi", "n")

// EIPSW - Exception/Interrupt saved PSW (regID 1)
// unsigned int __builtin_v850_read_eipsw(void)
BUILTIN(__builtin_v850_read_eipsw, "Ui", "n")
// void __builtin_v850_write_eipsw(unsigned int value)
BUILTIN(__builtin_v850_write_eipsw, "vUi", "n")

// FEPC - Fatal Error saved PC (regID 2)
// unsigned int __builtin_v850_read_fepc(void)
BUILTIN(__builtin_v850_read_fepc, "Ui", "n")
// void __builtin_v850_write_fepc(unsigned int value)
BUILTIN(__builtin_v850_write_fepc, "vUi", "n")

// FEPSW - Fatal Error saved PSW (regID 3)
// unsigned int __builtin_v850_read_fepsw(void)
BUILTIN(__builtin_v850_read_fepsw, "Ui", "n")
// void __builtin_v850_write_fepsw(unsigned int value)
BUILTIN(__builtin_v850_write_fepsw, "vUi", "n")

// ECR - Exception Cause Register (regID 4, read-only)
// unsigned int __builtin_v850_read_ecr(void)
BUILTIN(__builtin_v850_read_ecr, "Ui", "n")

// PSW - Program Status Word (regID 5)
// unsigned int __builtin_v850_read_psw(void)
BUILTIN(__builtin_v850_read_psw, "Ui", "n")
// void __builtin_v850_write_psw(unsigned int value)
BUILTIN(__builtin_v850_write_psw, "vUi", "n")

//===----------------------------------------------------------------------===//
// V850E1/ES Instructions
//
// These instructions require V850E1 or later architecture.
// The register-operand forms of bit manipulation and byte swap are V850E1+.
//===----------------------------------------------------------------------===//

// SET1 - Atomically set a bit in memory (register form)
// void __builtin_v850_set1(void *addr, unsigned int bit)
TARGET_BUILTIN(__builtin_v850_set1, "vv*Ui", "n", "v850e1")

// CLR1 - Atomically clear a bit in memory (register form)
// void __builtin_v850_clr1(void *addr, unsigned int bit)
TARGET_BUILTIN(__builtin_v850_clr1, "vv*Ui", "n", "v850e1")

// NOT1 - Atomically toggle a bit in memory (register form)
// void __builtin_v850_not1(void *addr, unsigned int bit)
TARGET_BUILTIN(__builtin_v850_not1, "vv*Ui", "n", "v850e1")

// TST1 - Test a bit in memory (register form)
// Returns Z flag value (1 if bit was 0, 0 otherwise)
// int __builtin_v850_tst1(void *addr, unsigned int bit)
TARGET_BUILTIN(__builtin_v850_tst1, "iv*Ui", "n", "v850e1")

// HSW - Halfword swap (swap upper and lower 16-bit halfwords)
// unsigned int __builtin_v850_hsw(unsigned int x)
// Result: (x >> 16) | (x << 16), i.e., 0xAABBCCDD -> 0xCCDDAABB
TARGET_BUILTIN(__builtin_v850_hsw, "UiUi", "nc", "v850e1")

// BSH - Byte swap halfword (swap bytes in each 16-bit halfword)
// unsigned int __builtin_v850_bsh(unsigned int x)
// Result: 0xAABBCCDD -> 0xBBAADDCC
TARGET_BUILTIN(__builtin_v850_bsh, "UiUi", "nc", "v850e1")

// MAC - Signed multiply-accumulate
// long long __builtin_v850_mac(int a, int b, long long acc)
// Returns: acc + (a * b) as 64-bit signed result
TARGET_BUILTIN(__builtin_v850_mac, "LLiiiLLi", "nc", "v850e1")

// MACU - Unsigned multiply-accumulate
// unsigned long long __builtin_v850_macu(unsigned int a, unsigned int b,
//                                        unsigned long long acc)
// Returns: acc + (a * b) as 64-bit unsigned result
TARGET_BUILTIN(__builtin_v850_macu, "ULLiUiUiULLi", "nc", "v850e1")

//===----------------------------------------------------------------------===//
// V850E1+ System Register Access
//
// Named builtins for V850E1+ system registers (regID 16-21).
// These registers are NOT available on base V850 or V850ES.
//===----------------------------------------------------------------------===//

// CTPC - CALLT saved PC (regID 16)
// unsigned int __builtin_v850_read_ctpc(void)
TARGET_BUILTIN(__builtin_v850_read_ctpc, "Ui", "n", "v850e1")
// void __builtin_v850_write_ctpc(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_ctpc, "vUi", "n", "v850e1")

// CTPSW - CALLT saved PSW (regID 17)
// unsigned int __builtin_v850_read_ctpsw(void)
TARGET_BUILTIN(__builtin_v850_read_ctpsw, "Ui", "n", "v850e1")
// void __builtin_v850_write_ctpsw(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_ctpsw, "vUi", "n", "v850e1")

// CTBP - CALLT Base Pointer (regID 20)
// unsigned int __builtin_v850_read_ctbp(void)
TARGET_BUILTIN(__builtin_v850_read_ctbp, "Ui", "n", "v850e1")
// void __builtin_v850_write_ctbp(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_ctbp, "vUi", "n", "v850e1")

//===----------------------------------------------------------------------===//
// V850E1+ Debug Instructions
//
// Debug trap and debug return instructions for software breakpoints.
//===----------------------------------------------------------------------===//

// DBTRAP - Debug trap (software breakpoint)
// void __builtin_v850_dbtrap(void)
// Triggers a debug exception, saving PC to DBPC and PSW to DBPSW.
// Use DBRET to return from the debug handler.
TARGET_BUILTIN(__builtin_v850_dbtrap, "v", "n", "v850e1")

//===----------------------------------------------------------------------===//
// V850E1+ Debug System Register Access
//
// Named builtins for V850E1+ debug system registers (regID 18-27).
// These registers are used for debugging and breakpoint control.
//===----------------------------------------------------------------------===//

// DBPC - Debug saved PC (regID 18)
// unsigned int __builtin_v850_read_dbpc(void)
TARGET_BUILTIN(__builtin_v850_read_dbpc, "Ui", "n", "v850e1")
// void __builtin_v850_write_dbpc(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_dbpc, "vUi", "n", "v850e1")

// DBPSW - Debug saved PSW (regID 19)
// unsigned int __builtin_v850_read_dbpsw(void)
TARGET_BUILTIN(__builtin_v850_read_dbpsw, "Ui", "n", "v850e1")
// void __builtin_v850_write_dbpsw(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_dbpsw, "vUi", "n", "v850e1")

// DIR - Debug Interface Register (regID 21)
// unsigned int __builtin_v850_read_dir(void)
TARGET_BUILTIN(__builtin_v850_read_dir, "Ui", "n", "v850e1")
// void __builtin_v850_write_dir(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_dir, "vUi", "n", "v850e1")

// Select breakpoint channel (0 or 1)
// void __builtin_v850_select_bp_channel(unsigned int channel)
// V850E1+ has 2 breakpoint channels selected via DIR.CS bit (bit 0).
// Channel 0 is selected when DIR.CS = 0, channel 1 when DIR.CS = 1.
// This builtin atomically reads DIR, modifies CS bit, and writes back.
TARGET_BUILTIN(__builtin_v850_select_bp_channel, "vUi", "n", "v850e1")

// BPC - Breakpoint Control (regID 22)
// unsigned int __builtin_v850_read_bpc(void)
TARGET_BUILTIN(__builtin_v850_read_bpc, "Ui", "n", "v850e1")
// void __builtin_v850_write_bpc(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_bpc, "vUi", "n", "v850e1")

// ASID - Address Space ID (regID 23)
// unsigned int __builtin_v850_read_asid(void)
TARGET_BUILTIN(__builtin_v850_read_asid, "Ui", "n", "v850e1")
// void __builtin_v850_write_asid(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_asid, "vUi", "n", "v850e1")

// BPAV - Breakpoint Address Value (regID 24)
// unsigned int __builtin_v850_read_bpav(void)
TARGET_BUILTIN(__builtin_v850_read_bpav, "Ui", "n", "v850e1")
// void __builtin_v850_write_bpav(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_bpav, "vUi", "n", "v850e1")

// BPAM - Breakpoint Address Mask (regID 25)
// unsigned int __builtin_v850_read_bpam(void)
TARGET_BUILTIN(__builtin_v850_read_bpam, "Ui", "n", "v850e1")
// void __builtin_v850_write_bpam(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_bpam, "vUi", "n", "v850e1")

// BPDV - Breakpoint Data Value (regID 26)
// unsigned int __builtin_v850_read_bpdv(void)
TARGET_BUILTIN(__builtin_v850_read_bpdv, "Ui", "n", "v850e1")
// void __builtin_v850_write_bpdv(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_bpdv, "vUi", "n", "v850e1")

// BPDM - Breakpoint Data Mask (regID 27)
// unsigned int __builtin_v850_read_bpdm(void)
TARGET_BUILTIN(__builtin_v850_read_bpdm, "Ui", "n", "v850e1")
// void __builtin_v850_write_bpdm(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_bpdm, "vUi", "n", "v850e1")

//===----------------------------------------------------------------------===//
// V850E2+ Bit Search Operations
//
// These instructions search for the first 0 or 1 bit from left or right.
// They return the bit position (0-31), or 32 if no bit is found.
//===----------------------------------------------------------------------===//

// SCH1L - Search for leftmost 1 (like 31 - CLZ, but returns 32 if input is 0)
// unsigned int __builtin_v850_sch1l(unsigned int x)
// Returns: Position of leftmost 1 bit (31 = MSB, 0 = LSB), or 32 if x == 0
TARGET_BUILTIN(__builtin_v850_sch1l, "UiUi", "nc", "v850e2")

// SCH1R - Search for rightmost 1 (like CTZ, but returns 32 if input is 0)
// unsigned int __builtin_v850_sch1r(unsigned int x)
// Returns: Position of rightmost 1 bit (0 = LSB, 31 = MSB), or 32 if x == 0
TARGET_BUILTIN(__builtin_v850_sch1r, "UiUi", "nc", "v850e2")

// SCH0L - Search for leftmost 0 (like 31 - CLO, but returns 32 if input is -1)
// unsigned int __builtin_v850_sch0l(unsigned int x)
// Returns: Position of leftmost 0 bit, or 32 if x == 0xFFFFFFFF
TARGET_BUILTIN(__builtin_v850_sch0l, "UiUi", "nc", "v850e2")

// SCH0R - Search for rightmost 0 (like CTO, but returns 32 if input is -1)
// unsigned int __builtin_v850_sch0r(unsigned int x)
// Returns: Position of rightmost 0 bit, or 32 if x == 0xFFFFFFFF
TARGET_BUILTIN(__builtin_v850_sch0r, "UiUi", "nc", "v850e2")

//===----------------------------------------------------------------------===//
// V850E2+ Byte/Halfword Swap Operations
//===----------------------------------------------------------------------===//

// HSH - Halfword swap halfword
// unsigned int __builtin_v850_hsh(unsigned int x)
// Sign-extends lower halfword to 32 bits, then swaps bytes within each halfword
TARGET_BUILTIN(__builtin_v850_hsh, "UiUi", "nc", "v850e2")

//===----------------------------------------------------------------------===//
// V850E2+ 3-operand Saturating Arithmetic
//
// These instructions perform saturating arithmetic with the result in a
// separate register (3-operand form: reg3 = saturate(reg1 op reg2)).
//===----------------------------------------------------------------------===//

// SATADD3 - 3-operand saturating add
// int __builtin_v850_satadd3(int a, int b)
// Returns: saturate(a + b) with result in separate register
TARGET_BUILTIN(__builtin_v850_satadd3, "iii", "nc", "v850e2")

// SATSUB3 - 3-operand saturating subtract
// int __builtin_v850_satsub3(int a, int b)
// Returns: saturate(a - b) with result in separate register
TARGET_BUILTIN(__builtin_v850_satsub3, "iii", "nc", "v850e2")

//===----------------------------------------------------------------------===//
// V850E2+ Exception Cause Registers
//
// Named builtins for V850E2+ exception cause registers (regID 13-14).
//===----------------------------------------------------------------------===//

// EIIC - EI Exception Cause Register (regID 13)
// unsigned int __builtin_v850_read_eiic(void)
TARGET_BUILTIN(__builtin_v850_read_eiic, "Ui", "n", "v850e2")
// void __builtin_v850_write_eiic(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_eiic, "vUi", "n", "v850e2")

// FEIC - FE Exception Cause Register (regID 14)
// unsigned int __builtin_v850_read_feic(void)
TARGET_BUILTIN(__builtin_v850_read_feic, "Ui", "n", "v850e2")
// void __builtin_v850_write_feic(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_feic, "vUi", "n", "v850e2")

//===----------------------------------------------------------------------===//
// V850E2M Instructions
//
// These instructions require V850E2M or later architecture.
// Memory barriers and FPU register access are V850E2M+.
//===----------------------------------------------------------------------===//

// SYNCP - Synchronize pipeline (full memory barrier)
// void __builtin_v850_syncp(void)
TARGET_BUILTIN(__builtin_v850_syncp, "v", "n", "v850e2m")

// SYNCM - Synchronize memory
// void __builtin_v850_syncm(void)
TARGET_BUILTIN(__builtin_v850_syncm, "v", "n", "v850e2m")

// SYNCE - Synchronize exceptions
// void __builtin_v850_synce(void)
TARGET_BUILTIN(__builtin_v850_synce, "v", "n", "v850e2m")

// CAXI - Compare and Exchange for Interlock (atomic CAS)
// unsigned int __builtin_v850_caxi(void *addr, unsigned int expected, unsigned
// int desired) Atomically: if (*addr == expected) *addr = desired; return old
// *addr
TARGET_BUILTIN(__builtin_v850_caxi, "Uiv*UiUi", "n", "v850e2m")

// SYSCALL - System call
// void __builtin_v850_syscall(unsigned int vector)
// Triggers a system call with the specified vector (0-255)
TARGET_BUILTIN(__builtin_v850_syscall, "vIUi", "n", "v850e2m")

// FETRAP - FE-level software trap
// void __builtin_v850_fetrap(unsigned int vector)
// Triggers an FE-level exception with the specified vector (1-15)
TARGET_BUILTIN(__builtin_v850_fetrap, "vIUi", "n", "v850e2m")

