//===----------------------------------------------------------------------===//
// RH850G3M Instructions
//
// These instructions require RH850G3M or later architecture.
// Includes load-linked/store-conditional atomics and instruction sync.
//===----------------------------------------------------------------------===//

// SYNCI - Synchronize instruction pipeline
// void __builtin_v850_synci(void)
// Ensures all preceding instructions complete before fetching new instructions.
// Required after self-modifying code or cache operations.
TARGET_BUILTIN(__builtin_v850_synci, "v", "n", "rh850g3m")

// SNOOZE - Enter low-power snooze state
// void __builtin_v850_snooze(void)
// Enters a low-power state until an interrupt or event occurs.
TARGET_BUILTIN(__builtin_v850_snooze, "v", "n", "rh850g3m")

// CLL - Clear load link state
// void __builtin_v850_cll(void)
// Clears the load-linked state (invalidates pending store-conditional).
TARGET_BUILTIN(__builtin_v850_cll, "v", "n", "rh850g3m")

// LDL.W - Load linked word
// unsigned int __builtin_v850_ldl_w(volatile unsigned int *ptr)
// Loads a word and establishes an exclusive monitor for store-conditional.
TARGET_BUILTIN(__builtin_v850_ldl_w, "UiUiC*", "n", "rh850g3m")

// STC.W - Store conditional word
// int __builtin_v850_stc_w(volatile unsigned int *ptr, unsigned int value)
// Stores a word if exclusive monitor is still valid. Returns 1 on success, 0 on
// failure.
TARGET_BUILTIN(__builtin_v850_stc_w, "iUi*Ui", "n", "rh850g3m")

// CACHE - Cache operation
// void __builtin_v850_cache(unsigned int cacheop, void *addr)
// Performs cache operation specified by cacheop on cache line at addr.
// cacheop values: CHBII=0x00, CIBII=0x20, CFALI=0x30, CISTI=0x38, CILDI=0x60
TARGET_BUILTIN(__builtin_v850_cache, "vIUiv*", "n", "rh850g3m")

// PREF - Prefetch
// void __builtin_v850_pref(unsigned int prefop, void *addr)
// Prefetches data at addr. prefop specifies prefetch type.
TARGET_BUILTIN(__builtin_v850_pref, "vIUiv*", "n", "rh850g3m")

// BINS - Bitfield Insert
// unsigned int __builtin_v850_bins(unsigned int dst, unsigned int src,
//                                  unsigned int pos, unsigned int width)
// Inserts 'width' bits from src (starting at bit 0) into dst at position 'pos'.
// Returns the modified dst value.
// pos must be 0-31, width must be 1-32, pos+width must be <= 32.
TARGET_BUILTIN(__builtin_v850_bins, "UiUiUiIUiIUi", "nc", "rh850g3m")

// LDSR with selID - Load to system register with group specification
// void __builtin_v850_ldsr_group(unsigned int value, unsigned int regID,
//                                unsigned int selID)
TARGET_BUILTIN(__builtin_v850_ldsr_group, "vUiIUiIUi", "n", "rh850g3m")

// STSR with selID - Store from system register with group specification
// unsigned int __builtin_v850_stsr_group(unsigned int regID,
//                                        unsigned int selID)
TARGET_BUILTIN(__builtin_v850_stsr_group, "UiIUiIUi", "n", "rh850g3m")

//===----------------------------------------------------------------------===//
// RH850G3M+ Named System Register Access (Groups 1-2)
//
// Convenience builtins for commonly-used G3M system registers.
// These expand to ldsr/stsr with the correct regID and selID.
//===----------------------------------------------------------------------===//

// --- Group 1: Machine Configuration ---

// RBASE - Reset vector base address (regID=2, selID=1)
TARGET_BUILTIN(__builtin_v850_read_rbase, "Ui", "n", "rh850g3m")
