TARGET_BUILTIN(__builtin_v850_write_fpst, "vUi", "n", "v850fpu")

// void __builtin_v850_write_fpcc(unsigned int value)
TARGET_BUILTIN(__builtin_v850_write_fpcc, "vUi", "n", "v850fpu")

