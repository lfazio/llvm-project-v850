#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

// V850 ELF Relocations
// Reference: V850 Family ABI Specification

// No relocation
ELF_RELOC(R_V850_NONE, 0)
// 32-bit absolute address
ELF_RELOC(R_V850_32, 1)
// 22-bit PC-relative address (for branch instructions)
ELF_RELOC(R_V850_22_PCREL, 2)
// 9-bit PC-relative address (for conditional branches)
ELF_RELOC(R_V850_9_PCREL, 3)
// Upper 16 bits of address
ELF_RELOC(R_V850_HI16, 4)
// Lower 16 bits of address
ELF_RELOC(R_V850_LO16, 5)
// 16-bit signed displacement
ELF_RELOC(R_V850_16, 6)
// 8-bit unsigned data
ELF_RELOC(R_V850_8, 7)
// 16-bit signed PC-relative displacement
ELF_RELOC(R_V850_SDA_16_16_OFFSET, 8)
// 15-bit signed displacement
ELF_RELOC(R_V850_SDA_15_16_OFFSET, 9)
// 7-bit unsigned displacement for EP-based access
ELF_RELOC(R_V850_ZDA_16_16_OFFSET, 10)
// 15-bit zero-extended displacement
ELF_RELOC(R_V850_ZDA_15_16_OFFSET, 11)
// 6-bit unsigned displacement
ELF_RELOC(R_V850_TDA_6_8_OFFSET, 12)
// 7-bit unsigned displacement
ELF_RELOC(R_V850_TDA_7_8_OFFSET, 13)
// 8-bit unsigned displacement
ELF_RELOC(R_V850_TDA_7_7_OFFSET, 14)
// 16-bit displacement
ELF_RELOC(R_V850_TDA_16_16_OFFSET, 15)
